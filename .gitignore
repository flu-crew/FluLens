# Rust / Tauri build output. desktop/target reaches 47 GB.
desktop/target/
desktop/gen/schemas/

# Build artefacts. desktop/dist/flulens.html is a COPY made by beforeBuildCommand;
# the canonical file is prototypes/flulens.html. Committing the copy guarantees the
# two drift apart.
desktop/dist/
dist/

# GitHub Pages output, if the site is ever assembled locally.
_site/

# Generated by tools/make_manifest.py. CONTRIBUTING tells contributors to run that
# against example_run/, so it WILL appear locally — but the manifest that ships is
# built at deploy time from whatever is actually being published. A committed copy
# would go stale silently, and stale is worse than absent here: FluLens trusts a
# manifest in preference to walking the directory.
example_run/manifest.json

# Copies the release workflow makes at the repository root before uploading them
# as release assets.
/flulens.html
/example_run.zip

# Development symlinks into local research data. These point at real study runs
# and metadata spreadsheets on the author's machine. See CONTRIBUTING.md — create
# them locally, never commit them.
prototypes/run
prototypes/meta.csv

# Local editor/agent config holding machine-specific absolute paths.
.claude/

# Internal engineering handoff. Contains unpublished results from the swine and
# cow studies (per-sample findings, marker frequencies, sample identifiers) and
# must not be published ahead of those papers.
HANDOFF.md

# This repository lives inside Dropbox, so conflicted copies are a real hazard:
# Dropbox creates them silently, and one committed by accident is both confusing
# and easy to miss in a 120-file diff.
*conflicted copy*
.dropbox
.dropbox.attr

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# R — tools/make_example_run.R is run from the repository root
.Rhistory
.RData
.Rproj.user/

# Python — tools/make_manifest.py
__pycache__/
*.pyc

# Never. Apple signing credentials belong in the keychain or in repository
# secrets; the notarisation certificate must not be committed in any form.
.env
*.p12
*.p8
*.certSigningRequest
CONTRIBUTING.md
RELEASING.md
